    "id": "usaspending-nuclear",
    "name": "USAspending nuclear procurement awards and modifications",
    "publisher": "U.S. Department of the Treasury",
    "authority_class": "official_government",
    "geographic_scope": ["US"],
    "endpoint": "https://api.usaspending.gov/api/v2/search/spending_by_award/",
    "allowed_hosts": ["api.usaspending.gov"],
    "access_method": "api",
    "auth_method": "none",
    "auth_env": null,
    "auth_placement": null,
    "auth_parameter": null,
    "terms_url": "https://api.usaspending.gov/",
    "archival_policy": "record_snapshot",
    "expected_cadence": "daily",
    "polling_interval_hours": 24,
    "supported_claim_types": ["financing", "federal_support", "supply_chain"],
    "adapter": "usaspending",
    "adapter_version": "1.2.0",
    "operational_state": "approved_automated",
    "empty_response_is_valid": true,
    "timeout_ms": 30000,
    "maximum_response_bytes": 25000000,
    "comparison_mode": "incremental",
    "incremental_record_id_path": "Award ID",
    "incremental_record_timestamp_path": "Last Modified Date",
    "accepted_content_types": ["application/json"],
    "request": {
      "method": "POST",
      "query": {},
      "headers": {},
      "body": {
        "filters": {
          "time_period": [{ "start_date": "{{since}}", "end_date": "{{today}}", "date_type": "last_modified_date" }],
          "keywords": ["nuclear"],
          "award_type_codes": ["A", "B", "C", "D"]
        },
        "fields": ["Award ID", "Recipient Name", "Award Amount", "Description", "Start Date", "End Date", "Awarding Agency", "Last Modified Date"],
        "page": 1,
        "limit": 100,
        "subawards": false
      }
    },
    "notes": "The incremental window uses Last Modified Date for procurement awards. USAspending forbids mixing award-type groups in one request, so grants, loans, and other assistance remain an explicit adapter coverage gap. Awards prove reported federal obligations, not project completion or total private financing."
  },
