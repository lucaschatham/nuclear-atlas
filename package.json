{
  "name": "nuclear-atlas",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "validate:ui": "node scripts/validate-ui.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:credibility": "node scripts/validate-credibility.mjs",
    "credibility:run": "node scripts/credibility/run.mjs",
    "credibility:probe": "node scripts/credibility/run.mjs --dry-run",
    "credibility:record-manual": "node scripts/credibility/record-manual.mjs",
    "credibility:proof": "node scripts/credibility/proof.mjs",
    "generate:downloads": "node scripts/generate-downloads.mjs",
    "generate:methodology": "tsx scripts/generate-methodology.mjs --diagrams",
    "generate:methodology:docs": "tsx scripts/generate-methodology.mjs",
    "predev": "node scripts/prepare-maplibre.mjs && npm run generate:downloads && npm run generate:methodology:docs",
    "prebuild": "node scripts/prepare-maplibre.mjs && npm run validate:data && npm run validate:credibility && npm run validate:ui && npm run generate:downloads && npm run generate:methodology:docs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.6.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "mermaid": "^11.17.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
